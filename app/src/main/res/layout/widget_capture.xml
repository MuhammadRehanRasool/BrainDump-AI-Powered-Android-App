<?xml version="1.0" encoding="utf-8"?>
<!-- 3x1 and wider: a search-bar style pill plus the mic.
     @android:id/background lets the launcher animate the widget into the capture sheet. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="8dp">

    <LinearLayout
        android:id="@+id/widget_type"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/widget_pill"
        android:contentDescription="@string/shortcut_type_long"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_tile"
            android:tint="@color/widget_text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_hint"
            android:textColor="@color/widget_text"
            android:textSize="16sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/widget_voice"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/widget_mic_background"
        android:contentDescription="@string/shortcut_voice_long"
        android:padding="12dp"
        android:src="@drawable/ic_mic"
        android:tint="@color/widget_mic_icon" />
</LinearLayout>
