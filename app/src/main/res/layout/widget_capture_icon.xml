<?xml version="1.0" encoding="utf-8"?>
<!-- 1x1: an app-icon-sized mic. Tap to dump by voice. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_voice"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:contentDescription="@string/shortcut_voice_long">

    <ImageView
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:background="@drawable/widget_mic_background"
        android:importantForAccessibility="no"
        android:padding="15dp"
        android:src="@drawable/ic_mic"
        android:tint="@color/widget_mic_icon" />
</FrameLayout>
